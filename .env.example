PORT=3000
PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_EMAILS=you@example.com

# Keep false until a licensed payment provider has approved this exact bill-assistance model in writing.
PAYMENTS_ENABLED=false
# Paystack signs webhooks with your secret key (sk_test_... or sk_live_...). Server-side only.
PAYSTACK_SECRET_KEY=

# Face + ID verification (Dojah EasyOnboard). App ID, public key and widget ID come from the Dojah dashboard.
DOJAH_APP_ID=
DOJAH_PUBLIC_KEY=
DOJAH_WIDGET_ID=
DOJAH_SECRET_KEY=

# Optional future X API OAuth integration. Public sharing works without API credentials.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Optional generative assistant. Keep the key server-side in Railway Variables only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
